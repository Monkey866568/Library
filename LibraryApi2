local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Library = {
    Version = "1.0.0",
}

local DEFAULT_THEME = {
    Window = Color3.fromRGB(10, 10, 10),
    Surface = Color3.fromRGB(18, 18, 18),
    Section = Color3.fromRGB(24, 24, 24),
    Control = Color3.fromRGB(31, 31, 31),
    Accent = Color3.fromRGB(255, 205, 45),
    Text = Color3.fromRGB(245, 245, 245),
    MutedText = Color3.fromRGB(175, 175, 175),
    Stroke = Color3.fromRGB(255, 255, 255),
}

local function mergeTheme(custom)
    local theme = table.clone(DEFAULT_THEME)
    if type(custom) == "table" then
        for key, value in pairs(custom) do
            if theme[key] ~= nil and typeof(value) == "Color3" then
                theme[key] = value
            end
        end
    end
    return theme
end

local function create(className, properties, parent)
    local instance = Instance.new(className)
    for property, value in pairs(properties or {}) do
        instance[property] = value
    end
    instance.Parent = parent
    return instance
end

local function addCorner(parent, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or 5),
    }, parent)
end

local function addStroke(parent, color, transparency, thickness)
    return create("UIStroke", {
        Color = color,
        Transparency = transparency or 0.6,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function addPadding(parent, left, right, top, bottom)
    return create("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
    }, parent)
end

local function invoke(callback, ...)
    if type(callback) ~= "function" then
        return
    end
    local ok, err = pcall(callback, ...)
    if not ok then
        warn("[RobloxUiLibrary] Callback error: " .. tostring(err))
    end
end

local function clampNumber(value, minimum, maximum)
    value = tonumber(value) or minimum
    return math.clamp(value, minimum, maximum)
end

local function makeText(parent, text, size, color, font, properties)
    local props = {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = tostring(text or ""),
        TextColor3 = color,
        TextSize = size or 15,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }
    for key, value in pairs(properties or {}) do
        props[key] = value
    end
    return create("TextLabel", props, parent)
end

local function tween(instance, properties, duration)
    local animation = TweenService:Create(
        instance,
        TweenInfo.new(duration or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        properties
    )
    animation:Play()
    return animation
end

local function makeDraggable(handle, target, connections)
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPosition = nil

    table.insert(connections, handle.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        dragging = true
        dragStart = input.Position
        startPosition = target.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end))

    table.insert(connections, handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))

    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
        if not dragging or input ~= dragInput or not dragStart or not startPosition then
            return
        end
        local delta = input.Position - dragStart
        target.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end))
end

local function makeControlRow(parent, theme, height)
    local row = create("Frame", {
        Name = "ControlRow",
        BackgroundColor3 = theme.Control,
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, height),
        ClipsDescendants = false,
    }, parent)
    addCorner(row, 5)
    return row
end

local function controlTextButton(parent, text, theme, size, properties)
    local props = {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = tostring(text or ""),
        TextColor3 = theme.Text,
        TextSize = 15,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false,
    }
    for key, value in pairs(properties or {}) do
        props[key] = value
    end
    if size then
        props.Size = size
    end
    return create("TextButton", props, parent)
end

function Library:CreateWindow(options)
    options = options or {}
    local player = Players.LocalPlayer
    assert(player, "CreateWindow must be called from a client LocalScript")

    local theme = mergeTheme(options.Theme)
    local screenGui = create("ScreenGui", {
        Name = options.GuiName or "ReusableDarkUi",
        ResetOnSpawn = false,
        IgnoreGuiInset = options.IgnoreGuiInset ~= false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = options.DisplayOrder or 20,
    }, options.Parent or player:WaitForChild("PlayerGui"))

    local width = math.max(560, tonumber(options.Width) or 800)
    local height = math.max(380, tonumber(options.Height) or 553)
    local windowFrame = create("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = options.Position or UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = theme.Window,
        BackgroundTransparency = 0.16,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, screenGui)
    addCorner(windowFrame, 5)
    addStroke(windowFrame, theme.Stroke, 0.58, 1)

    local titleBar = create("Frame", {
        Name = "TitleBar",
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 42),
    }, windowFrame)

    local title = makeText(titleBar, options.Title or "Function Section", 19, theme.Text, Enum.Font.GothamBold, {
        Name = "Title",
        Position = UDim2.fromOffset(16, 0),
        Size = UDim2.new(1, -70, 1, 0),
        TextTruncate = Enum.TextTruncate.AtEnd,
    })

    local closeButton = controlTextButton(titleBar, "×", theme, UDim2.fromOffset(42, 38), {
        Name = "CloseButton",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -4, 0.5, 0),
        TextSize = 26,
        Font = Enum.Font.Gotham,
    })
    closeButton.Activated:Connect(function()
        screenGui:Destroy()
    end)

    local body = create("Frame", {
        Name = "Body",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(12, 52),
        Size = UDim2.new(1, -24, 1, -64),
    }, windowFrame)

    local sidebar = create("Frame", {
        Name = "Sidebar",
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 190, 1, 0),
    }, body)
    addCorner(sidebar, 5)
    addStroke(sidebar, theme.Stroke, 0.72, 1)

    local tabList = create("ScrollingFrame", {
        Name = "TabList",
        Active = true,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(6, 6),
        Size = UDim2.new(1, -12, 1, -12),
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 5,
        ScrollBarImageColor3 = theme.Accent,
    }, sidebar)
    addPadding(tabList, 0, 2, 0, 0)
    create("UIListLayout", {
        Padding = UDim.new(0, 3),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, tabList)

    local pageHost = create("Frame", {
        Name = "PageHost",
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 0.16,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 202, 0, 0),
        Size = UDim2.new(1, -202, 1, 0),
        ClipsDescendants = true,
    }, body)
    addCorner(pageHost, 5)
    addStroke(pageHost, theme.Stroke, 0.72, 1)

    local connections = {}
    local tabs = {}
    local selectedTab = nil
    local window = {
        ScreenGui = screenGui,
        Frame = windowFrame,
        Theme = theme,
        Tabs = tabs,
        _connections = connections,
    }

    makeDraggable(titleBar, windowFrame, connections)

    local function selectTab(tab)
        if selectedTab == tab then
            return
        end
        selectedTab = tab
        for _, item in ipairs(tabs) do
            local active = item == tab
            item.Page.Visible = active
            item.Button.BackgroundColor3 = active and theme.Control or theme.Surface
            item.Bar.Visible = active
            item.Button.TextColor3 = active and theme.Text or theme.MutedText
        end
    end

    function window:AddTab(tabName, icon)
        tabName = tostring(tabName or ("Tab " .. tostring(#tabs + 1)))
        local tabButton = create("TextButton", {
            Name = "TabButton",
            BackgroundColor3 = theme.Surface,
            BackgroundTransparency = 0,
            BorderSizePixel = 0,
            Size = UDim2.new(1, 0, 0, 48),
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = #tabs + 1,
        }, tabList)
        addCorner(tabButton, 4)

        local activeBar = create("Frame", {
            Name = "ActiveBar",
            BackgroundColor3 = theme.Accent,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 0.18, 0),
            Size = UDim2.new(0, 5, 0.64, 0),
            Visible = false,
        }, tabButton)
        addCorner(activeBar, 4)

        local textOffset = 16
        if icon then
            local iconImage = create("ImageLabel", {
                Name = "Icon",
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Image = tostring(icon),
                ImageColor3 = theme.Text,
                Position = UDim2.fromOffset(14, 12),
                Size = UDim2.fromOffset(24, 24),
            }, tabButton)
            textOffset = 46
        end
        local tabTitle = makeText(tabButton, tabName, 15, theme.MutedText, Enum.Font.GothamMedium, {
            Position = UDim2.fromOffset(textOffset, 0),
            Size = UDim2.new(1, -textOffset - 8, 1, 0),
            TextTruncate = Enum.TextTruncate.AtEnd,
        })

        local page = create("ScrollingFrame", {
            Name = "Page_" .. tostring(#tabs + 1),
            Active = true,
            Visible = false,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(10, 10),
            Size = UDim2.new(1, -20, 1, -20),
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 6,
            ScrollBarImageColor3 = theme.Accent,
        }, pageHost)
        addPadding(page, 0, 3, 0, 4)
        create("UIListLayout", {
            Padding = UDim.new(0, 9),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, page)

        local tab = {
            Name = tabName,
            Button = tabButton,
            Title = tabTitle,
            Bar = activeBar,
            Page = page,
            Window = window,
            Sections = {},
        }
        table.insert(tabs, tab)
        tabButton.Activated:Connect(function()
            selectTab(tab)
        end)
        if #tabs == 1 then
            selectTab(tab)
        end

        function tab:AddSection(sectionName)
            sectionName = tostring(sectionName or "Section")
            local sectionFrame = create("Frame", {
                Name = "Section",
                BackgroundColor3 = theme.Section,
                BackgroundTransparency = 0.1,
                BorderSizePixel = 0,
                AutomaticSize = Enum.AutomaticSize.Y,
                Size = UDim2.new(1, -4, 0, 0),
                ClipsDescendants = false,
                LayoutOrder = #tab.Sections + 1,
            }, page)
            addCorner(sectionFrame, 5)
            addStroke(sectionFrame, theme.Stroke, 0.8, 1)
            addPadding(sectionFrame, 8, 8, 8, 8)

            local sectionTitle = makeText(sectionFrame, sectionName, 16, theme.Text, Enum.Font.GothamBold, {
                Name = "SectionTitle",
                Size = UDim2.new(1, 0, 0, 28),
            })
            local underline = create("Frame", {
                Name = "Underline",
                BackgroundColor3 = theme.Accent,
                BorderSizePixel = 0,
                Position = UDim2.new(0, 0, 0, 29),
                Size = UDim2.new(1, 0, 0, 2),
            }, sectionFrame)
            addCorner(underline, 1)

            local controls = create("Frame", {
                Name = "Controls",
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                Position = UDim2.fromOffset(0, 38),
                AutomaticSize = Enum.AutomaticSize.Y,
                Size = UDim2.new(1, 0, 0, 0),
            }, sectionFrame)
            create("UIListLayout", {
                Padding = UDim.new(0, 7),
                SortOrder = Enum.SortOrder.LayoutOrder,
            }, controls)

            local section = {
                Name = sectionName,
                Frame = sectionFrame,
                Controls = controls,
                Theme = theme,
            }
            table.insert(tab.Sections, section)

            function section:AddLabel(text)
                local label = makeText(controls, text or "label", 15, theme.Text, Enum.Font.Gotham, {
                    Name = "Label",
                    BackgroundColor3 = theme.Control,
                    BackgroundTransparency = 0.12,
                    Size = UDim2.new(1, 0, 0, 42),
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                })
                label.BackgroundTransparency = 0.12
                label.BackgroundColor3 = theme.Control
                addCorner(label, 5)
                addPadding(label, 12, 10, 4, 4)
                return label
            end

            function section:AddSeparator(text)
                local holder = create("Frame", {
                    Name = "Separator",
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 26),
                }, controls)
                local caption = makeText(holder, text or "", 12, theme.MutedText, Enum.Font.GothamMedium, {
                    Name = "Caption",
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.new(0.8, 0, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Center,
                })
                local left = create("Frame", {
                    BackgroundColor3 = theme.Accent,
                    BackgroundTransparency = 0.3,
                    BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 4, 0.5, 0),
                    Size = UDim2.new(0.5, -caption.Size.X.Offset / 2 - 10, 0, 1),
                }, holder)
                local right = create("Frame", {
                    BackgroundColor3 = theme.Accent,
                    BackgroundTransparency = 0.3,
                    BorderSizePixel = 0,
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -4, 0.5, 0),
                    Size = UDim2.new(0.5, -caption.Size.X.Offset / 2 - 10, 0, 1),
                }, holder)
                caption:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                    local half = caption.AbsoluteSize.X / 2 + 8
                    left.Size = UDim2.new(0.5, -half, 0, 1)
                    right.Size = UDim2.new(0.5, -half, 0, 1)
                end)
                return holder
            end

            function section:AddButton(settings, callback)
                if type(settings) == "string" then
                    settings = { Name = settings, Callback = callback }
                else
                    settings = settings or {}
                end
                local row = makeControlRow(controls, theme, 48)
                local button = controlTextButton(row, settings.Name or settings.Text or "Tap", theme, UDim2.new(1, 0, 1, 0), {
                    Name = "Button",
                    TextSize = 15,
                    Font = Enum.Font.GothamBold,
                })
                addCorner(button, 5)
                button.Activated:Connect(function()
                    tween(row, { BackgroundColor3 = theme.Accent }, 0.08)
                    task.delay(0.09, function()
                        if row.Parent then
                            tween(row, { BackgroundColor3 = theme.Control }, 0.14)
                        end
                    end)
                    invoke(settings.Callback or callback)
                end)
                return {
                    Instance = row,
                    Button = button,
                }
            end

            function section:AddToggle(settings)
                settings = settings or {}
                local value = settings.Default == true
                local row = makeControlRow(controls, theme, 48)
                local name = makeText(row, settings.Name or settings.Title or "Toggle", 15, theme.Text, Enum.Font.GothamMedium, {
                    Position = UDim2.fromOffset(12, 0),
                    Size = UDim2.new(1, -72, 1, 0),
                })
                local switch = create("Frame", {
                    Name = "Switch",
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, -11, 0.5, 0),
                    Size = UDim2.fromOffset(38, 21),
                    BackgroundColor3 = value and theme.Accent or Color3.fromRGB(65, 65, 65),
                    BorderSizePixel = 0,
                }, row)
                addCorner(switch, 11)
                local knob = create("Frame", {
                    Name = "Knob",
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = value and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                    Size = UDim2.fromOffset(15, 15),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BorderSizePixel = 0,
                }, switch)
                addCorner(knob, 8)
                local hitbox = controlTextButton(row, "", theme, UDim2.new(1, 0, 1, 0), {
                    Name = "Hitbox",
                    ZIndex = 2,
                })
                local function setValue(nextValue, fireCallback)
                    value = nextValue == true
                    tween(switch, { BackgroundColor3 = value and theme.Accent or Color3.fromRGB(65, 65, 65) }, 0.14)
                    tween(knob, { Position = value and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, 0.14)
                    if fireCallback ~= false then
                        invoke(settings.Callback, value)
                    end
                end
                hitbox.Activated:Connect(function()
                    setValue(not value, true)
                end)
                if settings.Default == true then
                    task.defer(function()
                        invoke(settings.Callback, true)
                    end)
                end
                return {
                    Instance = row,
                    GetValue = function() return value end,
                    SetValue = function(_, nextValue) setValue(nextValue, true) end,
                }
            end

            function section:AddSlider(settings)
                settings = settings or {}
                local minimum = tonumber(settings.Min or settings.Minimum) or 0
                local maximum = tonumber(settings.Max or settings.Maximum) or 100
                assert(maximum > minimum, "AddSlider requires Max > Min")
                local value = clampNumber(settings.Default or settings.Value or minimum, minimum, maximum)
                local row = makeControlRow(controls, theme, 68)
                local name = makeText(row, settings.Name or settings.Title or "Slider", 14, theme.Text, Enum.Font.GothamMedium, {
                    Position = UDim2.fromOffset(11, 4),
                    Size = UDim2.new(1, -105, 0, 27),
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })
                local valueLabel = makeText(row, tostring(value), 13, theme.Text, Enum.Font.GothamBold, {
                    Name = "Value",
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, -11, 0, 4),
                    Size = UDim2.fromOffset(85, 27),
                    TextXAlignment = Enum.TextXAlignment.Right,
                })
                local bar = create("Frame", {
                    Name = "SliderBar",
                    Position = UDim2.new(0, 11, 0, 43),
                    Size = UDim2.new(1, -22, 0, 8),
                    BackgroundColor3 = Color3.fromRGB(55, 55, 55),
                    BorderSizePixel = 0,
                }, row)
                addCorner(bar, 5)
                local percent = (value - minimum) / (maximum - minimum)
                local fill = create("Frame", {
                    Name = "Fill",
                    Size = UDim2.new(percent, 0, 1, 0),
                    BackgroundColor3 = theme.Accent,
                    BorderSizePixel = 0,
                }, bar)
                addCorner(fill, 5)
                local input = create("TextButton", {
                    Name = "Input",
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    Size = UDim2.new(1, 0, 0, 28),
                    Position = UDim2.new(0, 0, 0, 33),
                    ZIndex = 2,
                }, row)
                local dragging = false
                local function updateFromX(x, fireCallback)
                    local widthPx = math.max(bar.AbsoluteSize.X, 1)
                    local alpha = math.clamp((x - bar.AbsolutePosition.X) / widthPx, 0, 1)
                    local raw = minimum + (maximum - minimum) * alpha
                    local step = tonumber(settings.Step) or 1
                    value = math.clamp(minimum + math.floor((raw - minimum) / step + 0.5) * step, minimum, maximum)
                    local normalized = (value - minimum) / (maximum - minimum)
                    fill.Size = UDim2.new(normalized, 0, 1, 0)
                    valueLabel.Text = tostring(value)
                    if fireCallback ~= false then
                        invoke(settings.Callback, value)
                    end
                end
                input.InputBegan:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1
                        or inputObject.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        updateFromX(inputObject.Position.X, true)
                    end
                end)
                table.insert(connections, UserInputService.InputChanged:Connect(function(inputObject)
                    if dragging and (inputObject.UserInputType == Enum.UserInputType.MouseMovement
                        or inputObject.UserInputType == Enum.UserInputType.Touch) then
                        updateFromX(inputObject.Position.X, true)
                    end
                end))
                table.insert(connections, UserInputService.InputEnded:Connect(function(inputObject)
                    if inputObject.UserInputType == Enum.UserInputType.MouseButton1
                        or inputObject.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end))
                return {
                    Instance = row,
                    GetValue = function() return value end,
                    SetValue = function(_, nextValue)
                        nextValue = clampNumber(nextValue, minimum, maximum)
                        local alpha = (nextValue - minimum) / (maximum - minimum)
                        updateFromX(bar.AbsolutePosition.X + alpha * bar.AbsoluteSize.X, true)
                    end,
                }
            end

            function section:AddDropdown(settings)
                settings = settings or {}
                local optionsList = settings.Options or settings.Items or {}
                local selected = settings.Default
                local row = makeControlRow(controls, theme, 44)
                row.ClipsDescendants = true
                local mainButton = controlTextButton(row, "", theme, UDim2.new(1, 0, 0, 44), {
                    Name = "DropdownButton",
                    Text = "",
                })
                local label = makeText(mainButton, settings.Name or settings.Title or "Dropdown", 14, theme.Text, Enum.Font.GothamMedium, {
                    Position = UDim2.fromOffset(11, 0),
                    Size = UDim2.new(0.52, -10, 1, 0),
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })
                local selectedText = makeText(mainButton, selected and tostring(selected) or "Choose...", 13, theme.MutedText, Enum.Font.Gotham, {
                    Name = "SelectedValue",
                    Position = UDim2.new(0.52, 0, 0, 0),
                    Size = UDim2.new(0.42, -8, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Right,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                })
                local arrow = makeText(mainButton, "⌄", 20, theme.Text, Enum.Font.GothamBold, {
                    Name = "Arrow",
                    Position = UDim2.new(1, -32, 0, 0),
                    Size = UDim2.fromOffset(25, 42),
                    TextXAlignment = Enum.TextXAlignment.Center,
                })
                local optionContainer = create("Frame", {
                    Name = "Options",
                    BackgroundColor3 = theme.Surface,
                    BorderSizePixel = 0,
                    Position = UDim2.new(0, 5, 0, 47),
                    Size = UDim2.new(1, -10, 0, 0),
                    Visible = false,
                }, row)
                addCorner(optionContainer, 4)
                local optionScroll = create("ScrollingFrame", {
                    Name = "OptionList",
                    Active = true,
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    Position = UDim2.fromOffset(3, 3),
                    Size = UDim2.new(1, -6, 1, -6),
                    CanvasSize = UDim2.new(),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollBarThickness = 4,
                    ScrollBarImageColor3 = theme.Accent,
                }, optionContainer)
                create("UIListLayout", {
                    Padding = UDim.new(0, 3),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                }, optionScroll)
                local isOpen = false
                local function setOpen(open)
                    isOpen = open == true
                    local visibleHeight = math.min(#optionsList * 35 + 6, 145)
                    optionContainer.Visible = isOpen
                    optionContainer.Size = UDim2.new(1, -10, 0, isOpen and visibleHeight or 0)
                    row.Size = UDim2.new(1, 0, 0, isOpen and (51 + visibleHeight) or 44)
                    arrow.Text = isOpen and "⌃" or "⌄"
                end
                local function choose(item)
                    selected = item
                    selectedText.Text = tostring(item)
                    selectedText.TextColor3 = theme.Text
                    setOpen(false)
                    invoke(settings.Callback, item)
                end
                for index, item in ipairs(optionsList) do
                    local optionButton = controlTextButton(optionScroll, tostring(item), theme, UDim2.new(1, -2, 0, 32), {
                        Name = "Option",
                        BackgroundColor3 = theme.Control,
                        BackgroundTransparency = 0.08,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextSize = 13,
                        LayoutOrder = index,
                    })
                    addCorner(optionButton, 3)
                    addPadding(optionButton, 9, 6, 0, 0)
                    optionButton.Activated:Connect(function()
                        choose(item)
                    end)
                end
                mainButton.Activated:Connect(function()
                    setOpen(not isOpen)
                end)
                local function setValue(nextValue)
                    for _, item in ipairs(optionsList) do
                        if item == nextValue then
                            choose(item)
                            return
                        end
                    end
                    warn("[RobloxUiLibrary] Dropdown value is not in its options: " .. tostring(nextValue))
                end
                return {
                    Instance = row,
                    GetValue = function() return selected end,
                    GetOpen = function() return isOpen end,
                    SetOpen = function(_, open) setOpen(open) end,
                    SetValue = function(_, nextValue) setValue(nextValue) end,
                }
            end

            return section
        end

        -- Compatibility-friendly aliases for groupbox-style APIs.
        tab.AddLeftGroupbox = tab.AddSection
        tab.AddRightGroupbox = tab.AddSection
        return tab
    end

    function window:SetTitle(newTitle)
        title.Text = tostring(newTitle or "")
    end

    function window:SetVisible(isVisible)
        screenGui.Enabled = isVisible == true
    end

    function window:Toggle()
        screenGui.Enabled = not screenGui.Enabled
        return screenGui.Enabled
    end

    function window:Destroy()
        for _, connection in ipairs(connections) do
            if connection.Connected then
                connection:Disconnect()
            end
        end
        screenGui:Destroy()
    end

    return window
end

return Library
