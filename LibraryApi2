	}

	-- API: Tạo Tab
	function Window:CreateTab(tabName)
		local TabButton = Instance.new("TextButton", TabScroll)
		TabButton.Size = UDim2.new(0, 200, 0, 50)
		TabButton.BackgroundTransparency = 3
		TabButton.Text = tabName
		TabButton.TextColor3 = Library.Theme.White
		TabButton.TextSize = 15
		TabButton.FontFace = Font.new("rbxasset://fonts/families/Bangers.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal)

		local ActiveBar = Instance.new("Frame", TabButton)
		ActiveBar.Name = "Bar"
		ActiveBar.Size = UDim2.new(0, 8, 0, 31)
		ActiveBar.Position = UDim2.new(0, 0, 0.18, 0)
		ActiveBar.BackgroundColor3 = Library.Theme.White
		ActiveBar.Visible = false
		Instance.new("UICorner", ActiveBar).CornerRadius = UDim.new(0, 5)

		local ContainerScroll = Instance.new("ScrollingFrame", FuncSection)
		ContainerScroll.Name = tabName .. "_Scroll"
		ContainerScroll.Size = UDim2.new(0, 500, 0, 400)
		ContainerScroll.BackgroundTransparency = 3
		ContainerScroll.ScrollBarThickness = 10
		ContainerScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		ContainerScroll.Visible = false

		local MainLayout = Instance.new("UIListLayout", ContainerScroll)
		MainLayout.Padding = UDim.new(0, 8)

		MainLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			ContainerScroll.CanvasSize = UDim2.new(0, 0, 0, MainLayout.AbsoluteContentSize.Y + 20)
		end)

		local Tab = { Scroll = ContainerScroll }

		TabButton.MouseButton1Click:Connect(function()
			for _, t in pairs(Window.Tabs) do
				t.Button.Bar.Visible = false
				t.Scroll.Visible = false
			end
			ActiveBar.Visible = true
			ContainerScroll.Visible = true
			TabTitle.Text = tabName
		end)

		Tab.Button = TabButton
		table.insert(Window.Tabs, Tab)

		if #Window.Tabs == 1 then
			ActiveBar.Visible = true
			ContainerScroll.Visible = true
			TabTitle.Text = tabName
		end

		-- API: Tạo Nút Bấm (Button)
		function Tab:CreateButton(text, callback)
			local ButtonFrame = Instance.new("TextLabel", ContainerScroll)
			ButtonFrame.Size = UDim2.new(0, 489, 0, 50)
			ButtonFrame.BackgroundColor3 = Library.Theme.DarkSurface
			ButtonFrame.BackgroundTransparency = 0.1
