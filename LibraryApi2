			ButtonFrame.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Bold, Enum.FontStyle.Italic)
			Instance.new("UICorner", ButtonFrame)

			local TapBtn = Instance.new("TextButton", ButtonFrame)
			TapBtn.Size = UDim2.new(0, 113, 0, 35)
			TapBtn.Position = UDim2.new(0.73, 0, 0.14, 0)
			TapBtn.BackgroundColor3 = Library.Theme.White
			TapBtn.Text = "Tap"
			TapBtn.TextColor3 = Library.Theme.Background
			TapBtn.TextSize = 20
			TapBtn.FontFace = Font.new("rbxasset://fonts/families/Balthazar.json", Enum.FontWeight.Bold, Enum.FontStyle.Italic)
			Instance.new("UICorner", TapBtn).CornerRadius = UDim.new(1, 0)

			TapBtn.MouseButton1Click:Connect(function()
				if callback then callback() end
			end)
		end

		-- API: Tạo Nút Bật/Tắt (Toggle)
		function Tab:CreateToggle(text, callback)
			local ToggleFrame = Instance.new("Frame", ContainerScroll)
			ToggleFrame.Size = UDim2.new(0, 489, 0, 50)
			ToggleFrame.BackgroundColor3 = Library.Theme.DarkSurface
			ToggleFrame.BackgroundTransparency = 0.1
			Instance.new("UICorner", ToggleFrame)

			local Label = Instance.new("TextLabel", ToggleFrame)
			Label.Size = UDim2.new(0, 446, 0, 50)
			Label.BackgroundTransparency = 3
			Label.Text = text
			Label.TextColor3 = Library.Theme.White
			Label.TextSize = 15
			Label.FontFace = Font.new("rbxasset://fonts/families/DenkOne.json", Enum.FontWeight.Bold, Enum.FontStyle.Italic)

			local Border = Instance.new("Frame", ToggleFrame)
			Border.Size = UDim2.new(0, 30, 0, 30)
			Border.Position = UDim2.new(0.912, 0, 0.2, 0)
			Border.BackgroundColor3 = Library.Theme.Background
			Instance.new("UICorner", Border).CornerRadius = UDim.new(0, 5)

			local Btn = Instance.new("TextButton", Border)
			Btn.Size = UDim2.new(0, 20, 0, 20)
			Btn.Position = UDim2.new(0.166, 0, 0.166, 0)
			Btn.BackgroundTransparency = 3
			Btn.Text = ""

			local StatusFrame = Instance.new("Frame", Btn)
			StatusFrame.Size = UDim2.new(0, 20, 0, 20)
			StatusFrame.BackgroundColor3 = Library.Theme.White
			StatusFrame.Visible = false
			Instance.new("UICorner", StatusFrame).CornerRadius = UDim.new(0, 3)

			local toggled = false
			Btn.MouseButton1Click:Connect(function()
				toggled = not toggled
				StatusFrame.Visible = toggled
				if callback then callback(toggled) end
			end)
		end

		-- API: Tạo Thanh Trượt (Slider)
		function Tab:CreateSlider(text, min, max, default, callback)
			local SliderFrame = Instance.new("Frame", ContainerScroll)
			SliderFrame.Size = UDim2.new(0, 489, 0, 70)
			SliderFrame.BackgroundColor3 = Library.Theme.DarkSurface
			SliderFrame.BackgroundTransparency = 0.1
			Instance.new("UICorner", SliderFrame)

			local Label = Instance.new("TextLabel", SliderFrame)
			Label.Size = UDim2.new(0, 338, 0, 35)
			Label.BackgroundTransparency = 3
			Label.Text = text
			Label.TextColor3 = Library.Theme.White
			Label.TextSize = 16

			local ValLabel = Instance.new("TextLabel", SliderFrame)
			ValLabel.Size = UDim2.new(0, 151, 0, 35)
			ValLabel.Position = UDim2.new(0.69, 0, 0, 0)
			ValLabel.BackgroundTransparency = 3
			ValLabel.Text = tostring(default or min)
			ValLabel.TextColor3 = Library.Theme.White

			local SliderBar = Instance.new("Frame", SliderFrame)
			SliderBar.Size = UDim2.new(0, 489, 0, 7)
			SliderBar.Position = UDim2.new(0, 0, 0.7, 0)
			SliderBar.BackgroundColor3 = Color3.fromRGB(21, 21, 21)
			Instance.new("UICorner", SliderBar)

			local Fill = Instance.new("Frame", SliderBar)
			Fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
			Fill.BackgroundColor3 = Library.Theme.White
			Instance.new("UICorner", Fill)

			local dragging = false
			local function Update(inputX)
				local percent = math.clamp((inputX - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
				Fill.Size = UDim2.new(percent, 0, 1, 0)
				local val = math.floor(min + (max - min) * percent)
				ValLabel.Text = tostring(val)
				if callback then callback(val) end
			end

			SliderBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					Update(input.Position.X)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					Update(input.Position.X)
				end
			end)
		end

		return Tab
	end

	return Window
end

return Library
